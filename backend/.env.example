# Copy to backend/.env and fill in real values for deployment or local development

# PostgreSQL connection string (Render Postgres or other DB).
# Example (Render-managed): postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/chaostwin

# Optional: enable SQLAlchemy query logging
SQL_ECHO=false

# Local storage directories (relative to backend/). In cloud, storage is ephemeral.
UPLOAD_DIR=uploads
WORKSPACE_DIR=workspaces

# OpenAI credentials used for code intelligence features.
OPENAI_API_KEY=

# CORS configuration (frontend origin(s) that are allowed to call the backend).
# Provide a comma-separated list like:
# FRONTEND_ORIGINS=https://example.com,https://my-app.onrender.com
# For Render-hosted frontend, use the full Render URL (e.g. https://<name>.onrender.com).
# If unset, the server will allow localhost origins and will also permit *.onrender.com by default.
FRONTEND_ORIGINS=

# Optional: whether to allow credentials (cookies/authorization headers) across CORS.
# Note: when using `*` origins, credentials are automatically disabled to comply with the browser spec.
CORS_ALLOW_CREDENTIALS=true

# Legacy / alternative env var (kept for backwards compatibility):
# CHAOS_TWIN_CORS_ORIGINS=
